# =============================================================================
# Environment for the reward functions in reward_code/
#
# Values are the CODE defaults unless noted. "REQUIRED" = no default; the judge
# will not work without it.
#
# Two reward entry points, two judge namespaces:
#
#   dataset                  reward entry point                 judge
#   -----------------------  ---------------------------------  ------------
#   general_ifeval_unseen    qlcm/rewards/compute_score.py      none (rule)
#   general_chat_unseen      qlcm/rewards/compute_score.py      QLCM_JUDGE_*
#   general_safety_unseen    qlcm/rewards/compute_score.py      QLCM_JUDGE_*
#   identity_berry_train     qlcm/rewards/compute_score.py      QLCM_JUDGE_*
#   stage2_unseen            qlcm/rewards/qa_openrouter.py      QA_JUDGE_*
#
# Identity is just another family in compute_score.py, scored by the same
# QLCM_JUDGE_* judge as chat and safety.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. QLCM judge — chat, safety, identity
# -----------------------------------------------------------------------------
QLCM_JUDGE_API_BASE=https://openrouter.ai/api/v1     # REQUIRED
QLCM_JUDGE_MODEL=deepseek/deepseek-v4-flash-0731     # REQUIRED
QLCM_JUDGE_API_KEY=REPLACE_ME                        # default "EMPTY" (ok for local vLLM)

QLCM_JUDGE_TIMEOUT=60.0
QLCM_JUDGE_MAX_TOKENS=512
QLCM_JUDGE_MAX_RETRIES=3
QLCM_JUDGE_CONCURRENCY=32
QLCM_JUDGE_TEMPERATURE=0.0
QLCM_JUDGE_FORCE_JSON=1                              # 0 if the endpoint rejects response_format
QLCM_JUDGE_DISABLE_THINKING=1
QLCM_JUDGE_DISABLE_REASONING=0

# OpenRouter routing. Judge JSON quality varied sharply by provider on the same
# model — one returned 6/10 malformed responses, inventing fields. Verify a
# provider before adding it. Unset = let the router choose. Ignored when
# API_BASE is not OpenRouter (a plain vLLM server rejects the `provider` field).
QLCM_JUDGE_PROVIDER_ONLY=together,novita,makora,baseten,baidu,deepinfra
QLCM_JUDGE_PROVIDER_ORDER=together,novita,makora,baseten,baidu,deepinfra
QLCM_JUDGE_PROVIDER_IGNORE=
QLCM_JUDGE_PROVIDER_SORT=
QLCM_JUDGE_ALLOW_FALLBACKS=
# Code default is 1. Our provider pool needs 0, or requests get rejected.
QLCM_JUDGE_REQUIRE_PARAMETERS=0

# Reward when the safety judge fails after all retries. Deliberately NEUTRAL,
# not 0.0: a failed judge produced no verdict, so scoring it 0.0 asserts "worst
# possible answer" on the strength of an upstream 429. A genuine wrong-stance
# verdict still scores 0.0.
QLCM_SAFETY_JUDGE_FAILURE_REWARD=0.5


# -----------------------------------------------------------------------------
# 2. Identity
#    The dataset is Avey Berry. Nothing structural changed from the previous
#    identity — same scorer, same judge, same env; the identity card and prompt
#    wording in identity_judges.py were updated Olive -> Berry.
# -----------------------------------------------------------------------------
# Route ONLY the identity judge to a stronger model. Unset = QLCM_JUDGE_MODEL.
QLCM_IDENTITY_JUDGE_MODEL=

# Per-sample identity gate over EVERY non-identity row: one extra judge call per
# rollout, in every domain. OFF. Keep it off — it was the dominant source of
# judge failures on deepseek-v4-flash (json_object mode, no schema; pinned
# providers returned key-stripped objects that fail the verdict check, burn all
# retries, then fail open anyway). See the comment block in compute_score.py.
QLCM_IDENTITY_GATE=0

# Inner switch of check_global_identity_violation itself. ITS CODE DEFAULT IS
# TRUE — with QLCM_IDENTITY_GATE=0 it is never reached, but set it to 0 so
# enabling the gate later does not silently start billing a judge call per
# sample.
QLCM_GLOBAL_IDENTITY_CHECK_ENABLED=0

# NOTE: the identity reward FAILS CLOSED. An unreachable judge scores every
# identity row 0.0 — indistinguishable from a model that never gets it right.
# Confirm "[judge_client boot pid=...]" shows HAS_KEY=True on every worker.


# -----------------------------------------------------------------------------
# 3. QA judge — stage 2 (medical QA + conversations)
# -----------------------------------------------------------------------------
QA_JUDGE_OPENROUTER_API_KEY=REPLACE_ME               # REQUIRED
QA_JUDGE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
QA_JUDGE_MODEL=openai/gpt-5.6-luna                   # code default: openai/gpt-5.4-mini
QA_JUDGE_MAX_TOKENS=16384
QA_JUDGE_CONCURRENCY=8

# Reward when the QA judge refuses. Neutral, same reasoning as the safety one.
QA_JUDGE_REFUSAL_REWARD=0.5
QA_JUDGE_REFUSAL_DIR=                                # set a path to dump refusals

# Legacy answer-vs-gold length ratio penalty. Fires on ~0.1% of rows at these
# settings — effectively inert. Kept for compatibility.
QA_LEN_PENALTY_THRESHOLD=14.0
QA_LEN_PENALTY_K=0.05
QA_LEN_PENALTY_MAX=0.2

# Judge schema trims: drop the *_justification fields the reward never reads.
# They cost output tokens, ~94% of judge spend once prompt caching warms.
# Measured paired on 45 QA / 20 conversation rollouts x 4 repeats: no detectable
# score effect, ~29% cheaper. The *_category fields are KEPT — they precede each
# score in the schema and scaffold it. Set 0 to restore the full schemas.
QLCM_JUDGE_TRIM_QA=1
QLCM_JUDGE_TRIM_CONV=1

# Linear length cost on total words (think + answer), stage 2 rows.
# CODE DEFAULT IS 0.07; we moved to 0.02 after measuring that 0.07 had pushed
# responses below the point where extra length still bought accuracy.
# Calibration is model-specific — our operating point, not a recommendation.
QLCM_LEN_PENALTY_ENABLE=1
QLCM_LEN_COST_PER_1K_WORDS=0.02

# Read by the coding/SNOMED reward, which is NOT in this package. Leave unset.
OPENROUTER_API_KEY=
