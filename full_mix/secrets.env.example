# Copy this file to full_mix/secrets.env and fill in real values.
# full_mix/secrets.env is gitignored — the values never get committed.
#
# Every training script sources this file at the top via:
#   source "$(dirname "${BASH_SOURCE[0]}")/secrets.env"
#
# If you accidentally commit keys, rotate them immediately — they live in git
# history forever.

# ---- LLM judge (OpenRouter or self-hosted vLLM) ----
export FULL_MIX_JUDGE_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY_HERE

# Optional overrides — defaults are in each training script.
# export FULL_MIX_JUDGE_API_BASE=https://openrouter.ai/api/v1
# export FULL_MIX_JUDGE_MODEL=x-ai/grok-4.1-fast
# export FULL_MIX_JUDGE_DISABLE_THINKING=0
# export FULL_MIX_JUDGE_MAX_RETRIES=3
# export FULL_MIX_JUDGE_CONCURRENCY=16

# ---- Weights & Biases ----
export WANDB_API_KEY=YOUR_WANDB_KEY_HERE

# ---- Default model checkpoint path (override per-run via MODEL_PATH=...) ----
# export MODEL_PATH=/data/abdelrahman/qwen-sft/.../checkpoint-XXXX
